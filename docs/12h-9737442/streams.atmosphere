<streams>
<immutable_stream name="input"
                  io_type="pnetcdf,cdf5"
                  type="input"
                  filename_template="init_final.nc"
                  input_interval="initial_only" />
<immutable_stream name="restart"
                  io_type="pnetcdf,cdf5"
                  clobber_mode="replace_files"
                  type="input;output"
                  filename_template="iamas_rst.$Y-$M-$D_$h.$m.$s.nc"
                  input_interval="initial_only"
                  output_interval="10_00:00:00" />
<stream name="output"
        io_type="pnetcdf,cdf5"
        clobber_mode="replace_files"
        type="output"
        filename_template="iamas_out.$Y-$M-$D_$h.$m.$s.nc"
        output_interval="01:00:00" >
	<file name="stream_list.atmosphere.output"/>
</stream>
<stream name="diagnostics"
        io_type="pnetcdf,cdf5"
        clobber_mode="replace_files"
        type="output"
        filename_template="iamas_diag.$Y-$M-$D_$h.$m.$s.nc"
        output_interval="01:00:00" >
	<file name="stream_list.atmosphere.diagnostics"/>
</stream>
<stream name="surface"
        io_type="pnetcdf,cdf5"
        type="input"
        filename_template="surface_update.nc"
        filename_interval="none"
        input_interval="06:00:00" >
	<file name="stream_list.atmosphere.surface"/>
</stream>
<immutable_stream name="fdda"
                  type="input"
                  filename_template="x1.40962.fdda_update.nc"
                  filename_interval="none"
                  input_interval="6:00:00" />
<stream name="emission"
        io_type="pnetcdf,cdf5"
        type="input"
        filename_template="emission_update.nc"
        filename_interval="none"
        input_interval="01:00:00" >
	<file name="stream_list.atmosphere.emission"/>
	<var_struct name="emis_state"/>
</stream>
</streams>
